# Set real values in Coolify (app → Environment Variables). Never commit a real .env.
PORT=3000
DATABASE_URL=postgres://user:password@host:5432/dbname
MONGODB_URI=mongodb://user:password@host:27017/dbname?authSource=dbname&directConnection=true
# Required in production: at least 32 random characters
SESSION_SECRET=replace-with-a-long-random-string-of-32-chars-or-more
# Admin account seeded at startup when DATABASE_URL is set
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-deploying
PLATFORM_FEE_PCT=20
CREDIT_PRICE_AED=5

# Set to false only while serving over plain HTTP (cookies are Secure by default in production)
COOKIE_SECURE=true
